{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private workspace settings and active board pointer for an authenticated PLAND user.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "activeBoardId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "visibleCalendarIds": {
          "type": "array",
          "description": "Up to 30 selected Google Calendar IDs."
        },
        "targetCalendarId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 254
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "notesSeeded": {
          "type": "boolean"
        },
        "financeSeeded": {
          "type": "boolean"
        },
        "financeCurrency": {
          "type": "string",
          "enum": ["RUB", "USD", "EUR", "KZT", "BYN", "GEL", "TRY", "AED", "GBP", "CNY"]
        },
        "financeRates": {
          "type": "object",
          "description": "Exchange rates relative to RUB for multi-currency conversion (max 12 entries)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "email",
        "displayName",
        "activeBoardId",
        "visibleCalendarIds",
        "targetCalendarId",
        "theme",
        "createdAt",
        "updatedAt"
      ]
    },
    "BoardDoc": {
      "title": "BoardDoc",
      "description": "A single personal Kanban/planner board owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "color": {
          "type": "string",
          "enum": ["blue", "emerald", "violet", "amber", "rose"]
        },
        "order": {
          "type": "number"
        },
        "labels": {
          "type": "array",
          "description": "Board labels (max 30)."
        },
        "lists": {
          "type": "array",
          "description": "Board columns (max 30)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "title",
        "color",
        "order",
        "labels",
        "lists",
        "createdAt",
        "updatedAt"
      ]
    },
    "CardDoc": {
      "title": "CardDoc",
      "description": "A task card belonging to a specific user board.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "boardId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "order": {
          "type": "number"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        },
        "labelIds": {
          "type": "array",
          "description": "Attached label IDs (max 20)."
        },
        "checklist": {
          "type": "array",
          "description": "Checklist items (max 50)."
        },
        "startDate": {
          "type": "string",
          "maxLength": 64
        },
        "endDate": {
          "type": "string",
          "maxLength": 64
        },
        "allDay": {
          "type": "boolean"
        },
        "dueDate": {
          "type": "string",
          "maxLength": 64
        },
        "googleEventId": {
          "type": "string",
          "maxLength": 256
        },
        "googleCalendarId": {
          "type": "string",
          "maxLength": 256
        },
        "lastSyncedAt": {
          "type": "string",
          "maxLength": 64
        },
        "syncDirty": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "boardId",
        "ownerUid",
        "listId",
        "order",
        "title",
        "description",
        "labelIds",
        "checklist",
        "createdAt",
        "updatedAt"
      ]
    },
    "HabitDoc": {
      "title": "HabitDoc",
      "description": "A daily or weekly recurring personal habit owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "color": {
          "type": "string",
          "enum": ["blue", "emerald", "violet", "amber", "rose"]
        },
        "daysOfWeek": {
          "type": "array",
          "description": "ISO weekdays 1..7 when the habit is scheduled."
        },
        "targetCount": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "order": {
          "type": "number"
        },
        "completions": {
          "type": "object",
          "description": "Map of YYYY-MM-DD date keys to completion counts (max 730 entries)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "title",
        "color",
        "daysOfWeek",
        "targetCount",
        "unit",
        "order",
        "completions",
        "createdAt",
        "updatedAt"
      ]
    },
    "NoteFolderDoc": {
      "title": "NoteFolderDoc",
      "description": "A personal notebook folder (supports nested parentId) owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "parentId": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "color": {
          "type": "string",
          "enum": ["blue", "emerald", "violet", "amber", "rose"]
        },
        "order": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "parentId",
        "title",
        "color",
        "order",
        "createdAt",
        "updatedAt"
      ]
    },
    "NoteDoc": {
      "title": "NoteDoc",
      "description": "A Notion-style block note page belonging to a user, optionally placed inside a folder.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "folderId": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "icon": {
          "type": "string",
          "maxLength": 16
        },
        "pinned": {
          "type": "boolean"
        },
        "order": {
          "type": "number"
        },
        "blocks": {
          "type": "array",
          "description": "Ordered Notion-style content blocks (max 200)."
        },
        "updatedAtMs": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "folderId",
        "title",
        "icon",
        "pinned",
        "order",
        "blocks",
        "updatedAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "FinanceAccountDoc": {
      "title": "FinanceAccountDoc",
      "description": "A personal finance account or wallet owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "type": "string",
          "enum": ["card", "cash", "savings", "other"]
        },
        "currency": {
          "type": "string",
          "enum": ["RUB", "USD", "EUR", "KZT", "BYN", "GEL", "TRY", "AED", "GBP", "CNY"]
        },
        "initialBalance": {
          "type": "number"
        },
        "color": {
          "type": "string",
          "enum": ["blue", "emerald", "violet", "amber", "rose"]
        },
        "order": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "title",
        "type",
        "initialBalance",
        "color",
        "order",
        "createdAt",
        "updatedAt"
      ]
    },
    "FinanceCategoryDoc": {
      "title": "FinanceCategoryDoc",
      "description": "A personal budget category with an optional monthly spending limit.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "type": "string",
          "enum": ["expense", "income"]
        },
        "monthlyLimit": {
          "type": ["number", "null"]
        },
        "color": {
          "type": "string",
          "enum": ["blue", "emerald", "violet", "amber", "rose"]
        },
        "order": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "name",
        "kind",
        "monthlyLimit",
        "color",
        "order",
        "createdAt",
        "updatedAt"
      ]
    },
    "FinanceTransactionDoc": {
      "title": "FinanceTransactionDoc",
      "description": "A personal finance expense, income, or account transfer entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "kind": {
          "type": "string",
          "enum": ["expense", "income", "transfer"]
        },
        "amount": {
          "type": "number"
        },
        "toAmount": {
          "type": ["number", "null"]
        },
        "categoryId": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toAccountId": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "isRecurring": {
          "type": "boolean"
        },
        "createdAtMs": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "kind",
        "amount",
        "categoryId",
        "accountId",
        "toAccountId",
        "date",
        "note",
        "isRecurring",
        "createdAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "FinanceGoalDoc": {
      "title": "FinanceGoalDoc",
      "description": "A personal savings target / financial goal owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "targetAmount": {
          "type": "number"
        },
        "currentAmount": {
          "type": "number"
        },
        "deadline": {
          "type": ["string", "null"],
          "maxLength": 10
        },
        "color": {
          "type": "string",
          "enum": ["blue", "emerald", "violet", "amber", "rose"]
        },
        "order": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "title",
        "targetAmount",
        "currentAmount",
        "deadline",
        "color",
        "order",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private profile and workspace settings strictly isolated per authenticated owner."
    },
    "/users/{userId}/boards/{boardId}": {
      "schema": { "$ref": "#/entities/BoardDoc" },
      "description": "User-owned boards with bounded labels and column definitions."
    },
    "/users/{userId}/boards/{boardId}/cards/{cardId}": {
      "schema": { "$ref": "#/entities/CardDoc" },
      "description": "Task cards inside a user board, verified against parent board existence and ownership."
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": { "$ref": "#/entities/HabitDoc" },
      "description": "User-owned recurring habits with bounded weekday schedules and daily completion logs."
    },
    "/users/{userId}/noteFolders/{folderId}": {
      "schema": { "$ref": "#/entities/NoteFolderDoc" },
      "description": "User-owned notebook folders supporting hierarchical organization."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/NoteDoc" },
      "description": "User-owned Notion-style pages with bounded typed content blocks."
    },
    "/users/{userId}/financeAccounts/{accountId}": {
      "schema": { "$ref": "#/entities/FinanceAccountDoc" },
      "description": "User-owned financial accounts and wallets."
    },
    "/users/{userId}/financeCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/FinanceCategoryDoc" },
      "description": "User-owned budget categories with optional monthly spending limits."
    },
    "/users/{userId}/financeTransactions/{transactionId}": {
      "schema": { "$ref": "#/entities/FinanceTransactionDoc" },
      "description": "User-owned income, expense, and account transfer ledger records."
    },
    "/users/{userId}/financeGoals/{goalId}": {
      "schema": { "$ref": "#/entities/FinanceGoalDoc" },
      "description": "User-owned personal savings targets."
    }
  }
}
